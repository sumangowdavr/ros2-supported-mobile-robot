<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <model name="beni">
    <pose>0 0 0.102 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.025</ixx>
          <iyy>0.015</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 .18 0 0 0</pose>
      </inertial>
      <collision name="body_collision">
        <pose>0 0 .18 0 0 0</pose>
        <geometry>
          <box>
            <size>.20 .20 .32</size>
          </box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 .18 0 0 0</pose>
        <geometry>
          <box>
            <size>.20 .20 .32</size>
          </box>
        </geometry>
        <material>
          <ambient>.15 .18 .23 1</ambient>
          <diffuse>.15 .18 .23 1</diffuse>
        </material>
      </visual>
      <collision name="face_collision">
        <pose>.105 0 .28 0 0 0</pose>
        <geometry>
          <box>
            <size>.008 .15 .09</size>
          </box>
        </geometry>
      </collision>
      <visual name="face_visual">
        <pose>.105 0 .28 0 0 0</pose>
        <geometry>
          <box>
            <size>.008 .15 .09</size>
          </box>
        </geometry>
        <material>
          <ambient>.1 .55 .8 1</ambient>
          <diffuse>.1 .55 .8 1</diffuse>
        </material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu</topic>
        <imu />
      </sensor>
      <sensor name="camera" type="camera">
        <pose>.115 0 .28 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>20</far>
          </clip>
          <camera_info_topic>/camera/camera_info</camera_info_topic>
        </camera>
      </sensor>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 .36 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>10</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>0 0.145 0 -1.57079632679 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000435</ixx>
          <iyy>0.000435</iyy>
          <izz>0.00075</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="wheel_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>.06 .06 .06 1</ambient>
          <diffuse>.06 .06 .06 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>10</effort>
          <velocity>30</velocity>
        </limit>
      </axis>
    </joint>
    <link name="right_wheel">
      <pose>0 -0.145 0 -1.57079632679 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000435</ixx>
          <iyy>0.000435</iyy>
          <izz>0.00075</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="wheel_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>.06 .06 .06 1</ambient>
          <diffuse>.06 .06 .06 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>10</effort>
          <velocity>30</velocity>
        </limit>
      </axis>
    </joint>
    <link name="front_support">
      <pose>0.11 0 -.075 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>5e-06</ixx>
          <iyy>5e-06</iyy>
          <izz>5e-06</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="support_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.001</mu>
              <mu2>0.001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="support_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>.4 .4 .4 1</ambient>
          <diffuse>.4 .4 .4 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_support_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_support</child>
    </joint>
    <link name="rear_support">
      <pose>-0.11 0 -.075 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>5e-06</ixx>
          <iyy>5e-06</iyy>
          <izz>5e-06</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="support_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.001</mu>
              <mu2>0.001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="support_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>.4 .4 .4 1</ambient>
          <diffuse>.4 .4 .4 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rear_support_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_support</child>
    </joint>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.29</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>0.4</max_linear_velocity>
      <min_linear_velocity>-0.4</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity>
      <min_angular_velocity>-1.2</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
    </plugin>
  </model>
</sdf>